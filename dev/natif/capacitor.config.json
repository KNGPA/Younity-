{
  "appId": "io.github.kngpa.younity",
  "appName": "Younity",
  "webDir": "www",
  "server": {
    "url": "https://kngpa.github.io/Younity-/",
    "androidScheme": "https",
    "allowNavigation": [
      "kngpa.github.io"
    ],
    "errorPath": "hors-ligne.html"
  },
  "android": {
    "backgroundColor": "#135C2E"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 300,
      "launchAutoHide": true,
      "backgroundColor": "#135C2E",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false,
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#FFFFFF",
      "overlaysWebView": false
    }
  }
}